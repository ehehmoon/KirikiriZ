+// "N files, e.g. a, b, c" for the message shown when an archive has no
+// top-level startup.tjs
+static ttstr TVPDescribeArchiveEntries(const std::string &path) {
+    ttstr desc;
+    tTVPArchive *arc = nullptr;
+    try {
+        arc = TVPOpenArchive(TVPNormalizeStorageName(ttstr{ path }), false);
+        if(arc) {
+            tjs_uint count = arc->GetCount();
+            desc = ttstr(TJS_W("파일 ")) + ttstr((tjs_int)count) +
+                TJS_W("개 / files");
+            for(tjs_uint i = 0; i < count && i < 3; ++i) {
+                desc += i == 0 ? TJS_W(": ") : TJS_W(", ");
+                desc += arc->GetName(i);
+            }
+        }
+    } catch(...) {
+    }
+    delete arc;
+    return desc;
+}
+
+static bool TVPHasExtension(const std::string &path, const char *ext) {
+    size_t len = std::char_traits<char>::length(ext);
+    if(path.size() < len)
+        return false;
+    for(size_t i = 0; i < len; ++i) {
+        if(std::tolower((unsigned char)path[path.size() - len + i]) != ext[i])
+            return false;
+    }
+    return true;
+}
