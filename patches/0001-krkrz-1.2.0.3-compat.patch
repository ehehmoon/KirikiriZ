+//---------------------------------------------------------------------------
+// Kirikiri Z compatibility options. Read from the command line
+// (-krkrzcompat=no) or from the game's Kirikiroid2Preference.xml
+// (<Item key="krkrzcompat" value="no"/>).
+//---------------------------------------------------------------------------
+static bool TVPGetKrkrzOption(const tjs_char *cmdname, const char *cfgname,
+                              std::string &out) {
+    tTJSVariant val;
+    if(TVPGetCommandLine(cmdname, &val)) {
+        out = ttstr(val).AsStdString();
+        return true;
+    }
+    out = IndividualConfigManager::GetInstance()->GetValue<std::string>(
+        cfgname, "");
+    return !out.empty();
+}
+
+// enabled unless krkrzcompat is "no"; not cached because the per-game
+// preference can change between game launches
+bool TVPIsKrkrzCompatMode() {
+    std::string str;
+    if(TVPGetKrkrzOption(TJS_W("-krkrzcompat"), "krkrzcompat", str))
+        return !(str == "no" || str == "false" || str == "0");
+    return true;
+}
+
+bool TVPGetKrkrzVersionOption(std::string &out) {
+    return TVPGetKrkrzOption(TJS_W("-krkrzversion"), "krkrzversion", out);
+}
